GSM_DB_PASSWORD=generate-a-local-password
GSM_DEVELOPER_DB_PASSWORD=generate-a-separate-password
GSM_CONSUMER_DB_PASSWORD=generate-a-separate-password
GSM_DB_HOST=127.0.0.1
GSM_DB_PORT=55438
GSM_FILE_ROOT=./runtime/files
GSM_LLM_ENV_FILE=../.env
GSM_LLM_BASE_URL=https://api.deepseek.com
GSM_LLM_MODEL=deepseek-flash
GSM_CREDENTIAL_SIGNING_KEY=generate-a-local-32-byte-random-signing-key

# Optional matching tokenizer; leave unset for conservative UTF-8 byte estimates.
# GSM_TOKENIZER_FILE=./runtime/tokenizers/deepseek-v41/tokenizer.json
# GSM_TOKENIZER_SHA256=c90dfa01249db1be4245780a052ede752e1361c612ac6d08e2bdada7d599476b
